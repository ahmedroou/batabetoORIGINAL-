
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: يمكن للمستخدمين قراءة بيانات أي مستخدم (لجلب الأسماء)،
    // ولكن لا يمكنهم إنشاء أو تعديل إلا ملفهم الشخصي.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Games: يمكن لأي مستخدم مسجل الدخول إنشاء وقراءة وتحديث بيانات الغرف.
    // منطق اللعبة الموجود في الكود هو الذي يتحكم في تفاصيل اللعب.
    match /games/{gameId} {
      allow read, write: if request.auth != null;
    }

    // Questions: يمكن لأي مستخدم مسجل قراءة الأسئلة،
    // ولكن فقط الأدمن يمكنه إضافة أو حذف الأسئلة.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Game Settings: يمكن لأي شخص قراءة الإعدادات (مثل رابط الفيديو)،
    // ولكن فقط الأدمن يمكنه تعديلها.
    match /game_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
