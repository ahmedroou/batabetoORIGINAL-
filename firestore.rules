rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------
    // Helpers
    // -----------------------------
    function isSignedIn() { return request.auth != null }
    function uid() { return request.auth.uid }
    function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)) }
    function isAdmin() { return isSignedIn() && userDoc(uid()).data.isAdmin == true }

    // Safe empty fallbacks
    function m(v) { return v == null ? {} : v }   // map or empty map
    function l(v) { return v == null ? [] : v }   // list or empty list

    // Rate limit utilities (expects stored timestamps)
    function rlPath() {
      return /databases/$(database)/documents/rate_limits/$(uid())
    }
    function rlDoc() { return get(rlPath()) }

    // Returns true if now < (lastAction + duration)
    function isRateLimited(actionType, dur) {
      return isSignedIn()
             && exists(rlPath())
             && (rlDoc().data[actionType] is timestamp)
             && request.time < (rlDoc().data[actionType] + dur);
    }

    // Diff helpers
    function topLevelOnlyChanged(keys) {
      return resource.data.diff(request.resource.data).changedKeys().hasOnly(keys)
          && resource.data.diff(request.resource.data).addedKeys().hasOnly(keys)
          && resource.data.diff(request.resource.data).removedKeys().hasOnly(keys);
    }

    function onlySelfMapKeyChanged(before, after, k) {
      return m(before).diff(m(after)).changedKeys().hasOnly([k])
          && m(before).diff(m(after)).addedKeys().hasOnly([k])
          && m(before).diff(m(after)).removedKeys().hasOnly([k]);
    }

    function nestedOnlyChanged(parentBefore, parentAfter, keys) {
      return m(parentBefore).diff(m(parentAfter)).changedKeys().hasOnly(keys)
          && m(parentBefore).diff(m(parentAfter)).addedKeys().hasOnly(keys)
          && m(parentBefore).diff(m(parentAfter)).removedKeys().hasOnly(keys);
    }

    // -----------------------------
    // USERS
    // -----------------------------
    match /users/{userId} {
      // قراءة: صاحب الحساب أو الأدمن
      allow read: if isSignedIn() && (uid() == userId || isAdmin());

      // إنشاء: المستخدم نفسه فقط، ولا يسمح بضبط isAdmin
      allow create: if isSignedIn()
                    && uid() == userId
                    && (request.resource.data.isAdmin == null || request.resource.data.isAdmin == false);

      // تحديث: المالك أو الأدمن، مع منع تغيير isAdmin لغير الأدمن
      allow update: if isSignedIn()
                    && (uid() == userId || isAdmin())
