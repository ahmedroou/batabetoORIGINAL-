rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Game-specific rules for Word War
    match /games/{gameId} {
      allow read: if request.auth != null;
      
      // Allow update if the user is authenticated and the turn ID in the request
      // matches the one in the database. This prevents stale/out-of-order updates.
      // It also allows updates if the wordWarState or its turnId doesn't exist yet (e.g., during lobby setup).
      allow update: if request.auth != null && (
        !('wordWarState' in resource.data) ||
        !('turnId' in resource.data.wordWarState) ||
        resource.data.wordWarState.turnId == request.resource.data.wordWarState.turnId
      );
    }

    // Default insecure rules for other documents during development.
    // WARNING: Replace with secure rules before deploying to production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
