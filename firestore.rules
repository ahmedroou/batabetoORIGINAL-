
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // User profiles can only be created/updated by the user themselves.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }
    
    // Questions and settings are managed by server-side admin actions, so they are read-only for clients.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    match /game_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /games/{gameId} {
      // Any authenticated user can read game data.
      allow read: if request.auth != null;
      
      // CREATE: A user can create a game if they are authenticated and are correctly
      // set as the host and the first player in the `playerUids` list.
      allow create: if request.auth.uid != null
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.playerUids.size() == 1
                    && request.resource.data.playerUids[0] == request.auth.uid;

      // UPDATE: An authenticated user can update a game if:
      // 1. They are already a player in the game (for game actions like submitting answers).
      // 2. They are joining the game (the playerUids list is growing by exactly one, and their ID is the one being added).
      allow update: if request.auth.uid != null &&
                     (
                       request.auth.uid in resource.data.playerUids ||
                       (
                         resource.data.gameState == 'lobby' &&
                         request.resource.data.players.size() == resource.data.players.size() + 1 &&
                         request.auth.uid in request.resource.data.playerUids
                       )
                     );
                     
      // DELETE: Only the host can delete a game.
      allow delete: if request.auth.uid != null
                     && resource.data.hostId == request.auth.uid;
    }
  }
}
