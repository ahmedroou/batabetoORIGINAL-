rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are not secure for a production environment.
    // They allow any authenticated user to read and write to the entire database.
    // Secure your data before launching your app.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
