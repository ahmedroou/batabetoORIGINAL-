
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check the time difference in seconds
    function isRateLimited(userId, action, cooldownSeconds) {
      let lastActionTimestamp = get(/databases/$(database)/documents/rate_limits/$(userId)).data[action];
      return request.time > lastActionTimestamp && (request.time.toMillis() - lastActionTimestamp.toMillis()) < (cooldownSeconds * 1000);
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Any authenticated user can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users can be created during signup
      allow create: if request.auth != null;
      // Users can update their own profile, but cannot make themselves admin
      allow update: if request.auth != null && request.auth.uid == userId
                    && !("isAdmin" in request.resource.data)
                    && !("isEditor" in request.resource.data);
    }
    
    // Allow admins to read any user profile
    match /users/{userId} {
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Complaints Collection ---
    match /complaints/{complaintId} {
      // Allow create only if user is authenticated AND not rate-limited for this action (12 hours)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                       && !isRateLimited(request.auth.uid, 'submit_complaint', 43200); // 12 * 60 * 60 = 43200 seconds
      // Allow admins to read/update/delete complaints
      allow read, update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Rate Limits Collection ---
    match /rate_limits/{userId} {
      // The user themselves (or the system via server actions) can write to their own rate limit doc
      allow write: if request.auth != null && request.auth.uid == userId;
      // Only admins can read rate limits, not other users
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Other Collections (example: read-only for authenticated users) ---
    match /games/{gameId} {
      allow read: if request.auth != null;
      // Write/update rules should be specific to game logic inside server actions (transaction)
      allow write: if request.auth != null; // Keep it simple for now
    }
    
    match /game_settings/{settingId} {
        allow read: if true; // Public settings
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; // Admin only
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
