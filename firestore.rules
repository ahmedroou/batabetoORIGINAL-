rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are insecure and allow any authenticated user to read/write all data.
    // They should only be used for development and debugging.
    // Replace them with secure rules before deploying to production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
