
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are insecure and allow anyone to read and write to your database.
    // They should only be used for debugging purposes to isolate issues.
    // Replace them with secure rules before deploying to production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}