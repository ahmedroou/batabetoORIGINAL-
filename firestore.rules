rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for rate limiting
    function isRateLimited(userId, action, duration) {
      return !exists(/databases/$(database)/documents/rate_limits/$(userId)) ||
             request.time > get(/databases/$(database)/documents/rate_limits/$(userId)).data[action] + duration;
    }

    match /users/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /games/{gameId} {
      allow read;
      // Allow users to create new games, subject to rate limits.
      allow create: if request.auth != null;
      // Allow players in the game to update it, or authenticated users to delete it (admins can override).
      allow update, delete: if request.auth != null && (resource.data.playerUids.hasAny([request.auth.uid]));
    }

    match /game_settings/popularity {
        allow write: if request.auth != null && isRateLimited(request.auth.uid, 'create_game_room', duration.value(60, 's'));
    }

    match /complaints/{complaintId} {
      allow read: if request.auth != null; // Allow logged-in users to read (e.g. for admin panel)
      allow create: if request.auth != null && isRateLimited(request.auth.uid, 'submit_complaint', duration.value(43200, 's'));
      allow update, delete: if request.auth != null; // Typically only for admins, handled by server logic
    }
    
    match /rate_limits/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }

    // Allow read-only access to other game settings by default
    match /game_settings/{doc=**} {
      allow read;
    }
  }
}
