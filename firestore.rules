
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check rate limits
    function isRateLimited(userId, action, durationSeconds) {
      // Allow if the user has never performed this action before
      // or if enough time has passed since the last action.
      let lastActionTime = get(/databases/$(database)/documents/rate_limits/$(userId)).data[action];
      return lastActionTime == null || request.time.toMillis() - lastActionTime.toMillis() > (durationSeconds * 1000);
    }

    // -- Collections --

    // Games: can be read by anyone, but writes are restricted
    match /games/{gameId} {
      allow read;
      allow create: if request.auth != null && isRateLimited(request.auth.uid, 'create_game_room', 60);
      allow update: if request.auth != null; // Game logic is handled by server actions
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid; // Only host can delete lobby
    }

    // game_settings/popularity: allow authenticated users to increment game popularity
    match /game_settings/popularity {
      allow read;
      allow write: if request.auth != null;
    }

    // rate_limits: users can only update their own rate limit documents
    match /rate_limits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // complaints: allow creating documents under the same rate limit rules
    match /complaints/{complaintId} {
        allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
        allow create: if request.auth != null && isRateLimited(request.auth.uid, 'submit_complaint', 43200);
        allow update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // users: users can read their own data, and other authed users can read some public parts
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      // No delete rule for users for safety.
    }

    // All other collections default to no access.
    // Explicitly add rules for other collections like 'game_kings', 'leagues', etc. if needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
