rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRateLimited(action, duration) {
      return !exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid)) ||
             request.time > get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data[action] + duration;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // FIX: Allow clients to list/query users for leaderboards, etc.
      allow write: if isOwner(userId);
    }

    // Games collection
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isRateLimited('create_game_room', duration.value(60, 's'));
      allow update, delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        request.auth.uid in resource.data.playerUids
      );
    }
    
    // Complaints collection
    match /complaints/{complaintId} {
        allow create: if isSignedIn() && isRateLimited('submit_complaint', duration.value(43200, 's'));
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Game Settings
    match /game_settings/{settingId} {
        // Only admins can write to general settings
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
        
        // Anyone can read settings like ranks, prices, etc.
        allow get: if true;
        allow list: if true; // FIX: Allow clients to list/query settings documents.
    }
    
    // Specifically allow non-admins to update popularity stats
    match /game_settings/popularity {
        allow write: if isSignedIn();
    }
    
    // Rate limits can be written by anyone signed in
    match /rate_limits/{userId} {
      allow write: if isSignedIn() && isOwner(userId);
    }

  }
}
